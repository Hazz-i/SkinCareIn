# ==============================================================================
# SkinSight API - Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Application Environment (local vs production)
# ------------------------------------------------------------------------------
# local      -> email verification is BYPASSED (any 6-digit OTP is accepted and a new
#               account can sign in immediately). Handy for development.
# production -> the emailed OTP is MANDATORY and unverified accounts cannot log in.
#               ALWAYS set this to `production` on a real deployment.
APP_ENV=local

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/skinsight_db

# Docker Compose reads these to configure the bundled PostgreSQL container and to build the
# DATABASE_URL that the api1/api2 containers actually use (it overrides the line above).
# Leave them unset to keep the defaults below.
# NOTE: they only take effect when the volume is first created. If the postgres_data volume
# already exists, changing POSTGRES_PASSWORD here does nothing — delete the volume
# (`docker compose down -v`) to reinitialise, which also erases all data.
#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=change_me_before_deploying
#POSTGRES_DB=skinsight_db

# ------------------------------------------------------------------------------
# 2. Security & JWT Authentication
# ------------------------------------------------------------------------------
# Secret key used for signing HS256 JWT tokens (minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:8888,http://localhost:8000

# ------------------------------------------------------------------------------
# 5. AI Vision & LLM OCR Configuration (LiteLLM)
# ------------------------------------------------------------------------------
# Works with any OpenAI-compatible gateway (9Router, LiteLLM proxy, OpenRouter, ...).
# Default: 9Router running locally -> http://localhost:20128/v1
#   npm install -g 9router && 9router     (API key: copy from the dashboard)
# Leave LLM_API_BASE empty to call Google Gemini directly with GEMINI_API_KEY.
LLM_API_BASE=http://localhost:20128/v1
LLM_API_KEY=sk_9router

# Must be `openai/<model or combo>` — list them at GET http://localhost:20128/v1/models
# Examples: vertex/gemini-2.5-flash · kr/claude-sonnet-4.5 · gh/gemini-3.1-pro-preview
LLM_MODEL=openai/vertex/gemini-2.5-flash

# Optional LiteLLM-level fallbacks (comma separated). 9Router already fails over on
# its own, so this is usually left empty.
LLM_FALLBACKS=

# Only used when LLM_API_KEY is empty (direct Gemini access).
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 6. UV Index API (Real-time & Forecast)
# ------------------------------------------------------------------------------
# Free public API powered by NOAA. No API key or registration required.
# Docs: https://uvindexapi.com | Attribution to uvindexapi.com (CC BY-SA 4.0) is required.
UV_INDEX_API_BASE_URL=https://uvindexapi.com/api/v1
UV_INDEX_API_TIMEOUT=15
UV_INDEX_CACHE_TTL_HOURS=24

# ------------------------------------------------------------------------------
# 7. Rate Limiting (SlowAPI)
# ------------------------------------------------------------------------------
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_HEAVY=10/minute

# ------------------------------------------------------------------------------
# 8. SMTP Email Configuration & App URL
# ------------------------------------------------------------------------------
# Optional: Leave SMTP_HOST blank to use console logger fallback for local testing
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@skinsight.com
APP_BASE_URL=http://localhost:8888